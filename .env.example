# Copia este archivo como .env.local y rellena con los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Notificaciones push (Web Push). Se generan una sola vez con:
#   npx web-push generate-vapid-keys
# En Vercel hay que definir las tres variables en el entorno de Production.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Correo de contacto del titular: lo ven los servicios push (Google, Apple, Mozilla).
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Para enviar avisos reales fuera de producción (por defecto solo se envían en Production).
# PUSH_HABILITADO=1

# Secreto con el que pg_cron (Supabase) llama a /api/cron/*. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir en Vercel (Production) y en el Vault de Supabase, con el nombre cron_secret.
CRON_SECRET=

# Secreto (solo servidor, mínimo 32 caracteres) con el que se firma la cookie del enlace de
# «He olvidado mi contraseña». Genera uno con el mismo comando que CRON_SECRET (valor distinto).
# Defínelo también en Vercel (Production y Preview). Sin él la recuperación por email no deja
# fijar contraseña sin escribir la actual (falla cerrado).
RECUPERACION_SECRET=

# Gmail (Ajustes → Gmail): borradores de «Reclamar impagadas» con los PDF adjuntos.
# ID de cliente OAuth de tipo «Aplicación web» de Google Cloud, con la Gmail API activada y el
# URI de redirección <origen>/api/gmail/retorno. Defínelas también en Vercel (Production).
# Necesita además SUPABASE_SERVICE_ROLE_KEY (el token de Gmail solo lo lee el servidor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave de servicio de Supabase (solo servidor; Supabase → Project Settings → API → service_role).
# La usan: gestión del equipo, lectura de tickets con IA, fotos del enlace público, Gmail y push.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la app, sin barra final (p. ej. https://app.tudominio.es). Se usa en los
# enlaces de los emails y en los enlaces de campaña para el cliente. Si falta, en Vercel se usa el
# dominio de producción del proyecto; nunca la cabecera Origin de la petición.
NEXT_PUBLIC_SITE_URL=

# Escaneo de tickets con IA (Google AI Studio → API key de Gemini). Solo servidor.
GEMINI_API_KEY=

# Secreto (solo servidor, mínimo 32 caracteres) con el que se cifra en la base de datos el permiso
# de Gmail (AES-256-GCM). Genera uno con el mismo comando que CRON_SECRET (valor distinto).
# Si se cambia, hay que volver a conectar Gmail.
TOKENS_SECRET=
